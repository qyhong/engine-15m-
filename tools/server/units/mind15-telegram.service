[Unit]
Description=Mind 15 Telegram alerts and daily summary (reads the engine outputs only); own user + sandbox since 17 Nov 2026
After=network-online.target mind15.service
Wants=network-online.target

[Service]
Type=simple
User=mind15
Group=mind15
WorkingDirectory=/data/mind15
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/mind15
Environment=XDG_CACHE_HOME=/var/lib/mind15/.cache
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/data/venv/bin/python -W ignore -m engine15.telegram_notify
Restart=always
RestartSec=60
Nice=5
StandardOutput=append:/data/mind15/telegram.log
StandardError=append:/data/mind15/telegram.log
# sandbox: it may write only its own state file's folder; the push key is out of reach
ReadWritePaths=/data/mind15/data
InaccessiblePaths=-/etc/mind15 -/etc/aitrading-auth -/var/lib/aitrading-auth -/data/aitrading/backups -/etc/letsencrypt -/etc/ait-engine
UMask=0002
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
