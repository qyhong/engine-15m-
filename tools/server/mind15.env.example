# /data/mind15/mind15.env on the box: the switches run_live.sh loads before starting the engine (mode 640, ec2-user:mind15).
# This file lists the NAMES the code reads, with what each does. It holds no secret and it is NOT a copy of the box's
# file: nobody in this project reads that file. After a rebuild the owner (or the session that owns the item) sets the
# values; ask before guessing. Lines marked [box] were recorded as set on the box in HANDOFF.md; the others are optional.
#
# --- how the engine steps
ENGINE15_LEAN=1                      # [box] the lean step
ENGINE15_PARALLEL=1                  # [box] market groups in parallel processes (value recorded in HANDOFF.md, not verified here)
ENGINE15_PARALLEL_TIMEOUT=           # [box] seconds a group may take before it is given up for this step
#ENGINE15_PARALLEL_START=            # optional
#ENGINE15_PARALLEL_BAR_WAIT=         # optional
#ENGINE15_MARKETS=                   # optional: limit the market groups
#ENGINE15_EVCHECK=                   # optional: the reading-cache self check
# --- inputs
ENGINE15_KRONOS=/var/www/aitrading   # [box] folder of the candle-forecast feed (forecasts.json, news.json); the AI Trading Bot session's
#ENGINE15_ESTATE=/data/estate        # [box] estate files copied to the box
# --- pushing the page (ENGINE15_PUSH itself is set in the unit file: 1)
#ENGINE15_PUSH_HOST=                 # the web box
#ENGINE15_PUSH_KEY=                  # PATH of the push key file (never the key itself)
#MIND15_PULL_KEY=                    # PATH of the key for pulling web answers
#MIND15_PULL_TOOL=/data/mind15/tools/pull_answers.py
#MIND15_INBOX=
# --- the Setups file and the VIP vault (the money path; see CLAUDE.md)
MIND15_SETUPS_WEB_DIR=               # [box] folder the site serves setups.json from
MIND15_VAULT_CONFIG=/etc/ait-engine/engine.json   # [box] set = the vault feed is ON. The file and what it names belong to the AI Trading Bot session's installer
#MIND15_VAULT_SYMBOLS=BTCUSDT,ETHUSDT             # default; never wider without the owner's word
# --- other outputs
#MIND15_STOCKS=
#MIND15_TOP5_FILE=
#MIND15_CHECK_ALERT_ROWS=
# --- the Telegram bot (its own unit; the token is a FILE the owner puts on the box, never a value here)
#MIND15_TELEGRAM_TOKEN_FILE=         # PATH only
#ENGINE15_CHAT_MODEL=
